        pcall(function()
            hookmetamethod(game, "__namecall", SA2.namecallOld)
        end)
        SA2.namecallOld = nil
    end
    if SA2.indexOld and hookmetamethod then
        pcall(function()
            hookmetamethod(game, "__index", SA2.indexOld)
        end)
        SA2.indexOld = nil
    end
    SA2.hookActive = false
    SA2.mouseHookActive = false
